// Project tasks for Zed: `task: spawn` (alt-shift-t). See .zed/README.md.
[
    {
        "label": "Next: Dev",
        "command": "npm",
        "args": ["run", "dev"],
        "cwd": "$ZED_WORKTREE_ROOT",
        "use_new_terminal": true,
        "allow_concurrent_runs": false,
    },
    {
        // The dev server with the inspector open, for "Next: Attach server" in debug.json.
        "label": "Next: Dev (debug)",
        "command": "npm",
        "args": ["run", "dev"],
        "env": { "NODE_OPTIONS": "--inspect" },
        "cwd": "$ZED_WORKTREE_ROOT",
        "use_new_terminal": true,
        "allow_concurrent_runs": false,
    },
    {
        "label": "Next: Build",
        "command": "npm",
        "args": ["run", "build"],
        "cwd": "$ZED_WORKTREE_ROOT",
        "allow_concurrent_runs": false,
    },
    {
        "label": "Lint",
        "command": "npm",
        "args": ["run", "lint"],
        "cwd": "$ZED_WORKTREE_ROOT",
        "allow_concurrent_runs": false,
    },
    {
        "label": "GitHub: Dashboard",
        "command": "gh",
        "args": ["dash", "--config", ".zed/gh-dash.yml"],
        "cwd": "$ZED_WORKTREE_ROOT",
        "use_new_terminal": true,
        "allow_concurrent_runs": false,
    },
]
